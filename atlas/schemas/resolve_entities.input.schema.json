{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tmp_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "person",
              "concept",
              "place",
              "event",
              "instrument",
              "topic"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "doc_id": {
                  "type": "string",
                  "minLength": 1
                },
                "span": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "quote_hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{12}$"
                }
              },
              "required": [
                "doc_id",
                "span",
                "quote_hash"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "node_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "tmp_id",
          "type",
          "name",
          "aliases",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "node_id",
          "type",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "ts": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "meta": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "source",
          "ts",
          "text",
          "meta"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 50
    }
  },
  "required": [
    "candidates",
    "nodes",
    "documents"
  ],
  "additionalProperties": false
}

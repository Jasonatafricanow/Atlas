{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "extract_entities",
        "resolve_entities",
        "gen_propositions",
        "cluster_lens",
        "verify"
      ]
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "doc_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "task_id",
    "kind",
    "schema_version",
    "prompt_version",
    "doc_ids",
    "input_hash",
    "created_at"
  ],
  "additionalProperties": false
}

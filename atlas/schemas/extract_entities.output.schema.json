{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tmp_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "person",
              "concept",
              "place",
              "event",
              "instrument",
              "topic"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "doc_id": {
                  "type": "string",
                  "minLength": 1
                },
                "span": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "quote_hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{12}$"
                }
              },
              "required": [
                "doc_id",
                "span",
                "quote_hash"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "tmp_id",
          "type",
          "name",
          "aliases",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string",
            "minLength": 1
          },
          "dst": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "valid_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "valid_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "doc_id": {
                  "type": "string",
                  "minLength": 1
                },
                "span": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "quote_hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{12}$"
                }
              },
              "required": [
                "doc_id",
                "span",
                "quote_hash"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "supersedes": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "src",
          "dst",
          "type",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "statements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tmp_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "fact",
              "opinion",
              "plan",
              "preference"
            ]
          },
          "about": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "stance": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "doc_id": {
                  "type": "string",
                  "minLength": 1
                },
                "span": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "quote_hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{12}$"
                }
              },
              "required": [
                "doc_id",
                "span",
                "quote_hash"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "tmp_id",
          "kind",
          "about",
          "text",
          "confidence",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "entities",
    "relations",
    "statements"
  ],
  "additionalProperties": false
}

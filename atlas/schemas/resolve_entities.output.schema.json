{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "op": {
            "enum": [
              "ADD",
              "MERGE_INTO",
              "NOOP"
            ]
          },
          "tmp_id": {
            "type": "string",
            "minLength": 1
          },
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "op",
          "tmp_id",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "ops"
  ],
  "additionalProperties": false
}

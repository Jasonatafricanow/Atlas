{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "subgraph": {
      "type": "object"
    },
    "propositions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "ts": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "meta": {
            "type": "object"
          },
          "numbered_text": {
            "type": "string"
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "source",
          "ts",
          "meta"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "text"
            ]
          },
          {
            "required": [
              "numbered_text",
              "ref"
            ]
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "node_id",
    "subgraph",
    "propositions",
    "corrections",
    "documents"
  ],
  "additionalProperties": false
}

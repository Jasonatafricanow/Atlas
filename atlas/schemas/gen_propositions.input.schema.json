{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "subgraph": {
      "type": "object"
    },
    "propositions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prop_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "subject_node_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "doc_id": {
                  "type": "string",
                  "minLength": 1
                },
                "span": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "quote_hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{12}$"
                }
              },
              "required": [
                "doc_id",
                "span",
                "quote_hash"
              ],
              "additionalProperties": false
            },
            "minItems": 2
          },
          "counter_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "doc_id": {
                  "type": "string",
                  "minLength": 1
                },
                "span": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "quote_hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{12}$"
                }
              },
              "required": [
                "doc_id",
                "span",
                "quote_hash"
              ],
              "additionalProperties": false
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "valid_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "valid_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "proposed",
              "confirmed",
              "rejected",
              "superseded"
            ]
          },
          "superseded_by": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "prop_id",
          "text",
          "subject_node_ids",
          "evidence",
          "counter_evidence",
          "confidence",
          "valid_from",
          "valid_to",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "node_id",
    "subgraph",
    "propositions",
    "corrections"
  ],
  "additionalProperties": false
}

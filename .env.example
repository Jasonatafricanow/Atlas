# Absolute paths OUTSIDE this repository. Never commit a real .env.
ATLAS_DATA_DIR=/path/to/your/private/atlas-data
ATLAS_OUT_DIR=/path/to/your/private/atlas-out
# Optional: newline-separated private terms (names etc.) for tools/leak_scan.py, kept outside the repo
ATLAS_LEAK_DENYLIST=/path/to/your/private/leak_denylist.txt
